"""Audit trail — S3 WORM (Object Lock, compliance mode)."""

from aws_cdk import Duration, RemovalPolicy
from aws_cdk import aws_iam as iam
from aws_cdk import aws_s3 as s3


def add_audit_resources(stack, agent_id: str) -> None:
    bucket = s3.Bucket(
        stack,
        "AgentAuditBucket",
        bucket_name=f"panasa-agent-{agent_id}-audit",
        object_lock_enabled=True,
        object_lock_default_retention=s3.ObjectLockRetention.compliance(Duration.days(365)),
        removal_policy=RemovalPolicy.RETAIN,
    )

    stack.agent_execution_role.add_to_policy(
        iam.PolicyStatement(
            effect=iam.Effect.ALLOW,
            actions=["s3:PutObject"],
            resources=[bucket.arn_for_objects("*")],
        )
    )
