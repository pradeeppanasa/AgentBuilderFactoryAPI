"""API Gateway front door."""

from aws_cdk import aws_apigatewayv2 as apigwv2


def add_api_gateway_resources(stack, agent_id: str) -> None:
    compute_lambda_arn = stack.node.try_get_context("compute_lambda_arn")

    api = apigwv2.CfnApi(
        stack,
        "AgentApi",
        name=f"panasa-agent-{agent_id}",
        protocol_type="HTTP",
    )

    integration = apigwv2.CfnIntegration(
        stack,
        "AgentComputeIntegration",
        api_id=api.ref,
        integration_type="AWS_PROXY",
        integration_uri=compute_lambda_arn,
        integration_method="POST",
        payload_format_version="2.0",
    )

    apigwv2.CfnRoute(
        stack,
        "AgentInvokeRoute",
        api_id=api.ref,
        route_key="POST /invoke",
        target=f"integrations/{integration.ref}",
    )

    apigwv2.CfnStage(
        stack,
        "AgentApiStage",
        api_id=api.ref,
        stage_name="$default",
        auto_deploy=True,
    )
