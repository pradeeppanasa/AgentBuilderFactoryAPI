{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — agent runtime identity (least privilege, Section 11)
## Agent: {{ agent_id }}  Version: {{ version }}
## Generic Agent Runtime instruction (2026-09-03): agent_execution_role is
## used as BOTH compute.tf's ECS task executionRoleArn (image pull, log
## delivery) and taskRoleArn (the running container's own AWS calls) — one
## role for both, same simplification the compute module already made.
## Every other module attaches the extra permissions IT needs directly to
## this role (guardrails.tf's bedrock:ApplyGuardrail, rag.tf's KB retrieve,
## tools.tf's per-tool lambda:InvokeFunction, …) — this file only owns the
## baseline every agent needs regardless of config: pulling its own image,
## writing its own logs, reading its own config row, and calling Bedrock
## for LLM inference (services/agent-runtime/config_loader.py, llm_client.py).

data "aws_caller_identity" "current" {}

resource "aws_iam_role" "agent_execution_role" {
  name = "panasa-{{ agent_id }}-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
    }]
  })
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

## Split into one aws_iam_role_policy per concern — not one combined
## multi-statement resource — matching every other module's own IAM
## policies below (guardrails.tf's guardrail_invoke, rag.tf's
## agent_kb_retrieve, tools.tf's agent_invoke_tools, …), and required by
## the IaC validation suite's iam_no_wildcard_actions_or_resources check:
## it evaluates a whole aws_iam_role_policy resource's policy JSON as one
## blob (not per-Statement), so a single multi-statement resource combining
## an exempt wildcard action with an unrelated scoped one reads as the
## scoped action ALSO being overly permissive.

resource "aws_iam_role_policy" "agent_ecs_image_pull" {
  # ECR's GetAuthorizationToken has no resource-level permissions in AWS's
  # IAM action reference (account-wide only, same documented exception
  # pattern as observability.tf.j2's X-Ray statement) — the
  # BatchCheckLayerAvailability/GetDownloadUrlForLayer/BatchGetImage trio
  # could in principle be scoped to the one shared agent-runtime repo, but
  # that repo ARN isn't known to this config (it's a customer-supplied
  # deploy target, tfvars.py, not a resource this Terraform creates) —
  # kept together with GetAuthorizationToken here rather than split into
  # yet another resource for one shared, non-secret repo every agent pulls
  # the exact same image from.
  name = "panasa-{{ agent_id }}-ecs-image-pull"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["ecr:GetAuthorizationToken", "ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"]
      Resource = "*"
    }]
  })
}

resource "aws_iam_role_policy" "agent_ecs_log_delivery" {
  name = "panasa-{{ agent_id }}-ecs-log-delivery"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"]
      Resource = "${aws_cloudwatch_log_group.agent_logs.arn}:*"
    }]
  })
}

resource "aws_iam_role_policy" "agent_read_own_config" {
  # config_loader.py — every agent's own task role needs read access to
  # its own row (and only its own row) in the shared agents +
  # agent-versions tables: the first tells it which version is live, the
  # second holds that version's actual AgentConfiguration.
  name = "panasa-{{ agent_id }}-read-own-config"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = "dynamodb:GetItem"
      Resource = [
        "arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/{{ dynamodb_agents_table }}",
        "arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/{{ dynamodb_versions_table }}",
      ]
    }]
  })
}

resource "aws_iam_role_policy" "agent_llm_inference" {
  # llm_client.py — needed unconditionally regardless of which
  # model_id/model_provider this agent's config picks (or falls back to)
  # at runtime; a config-driven model choice can't be resolved to one
  # fixed model ARN at Terraform render time without defeating the whole
  # point of loading it from DynamoDB instead.
  name = "panasa-{{ agent_id }}-llm-inference"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"]
      Resource = "*"
    }]
  })
}

{% if agent.memory.memory_type == "persistent" %}
resource "aws_iam_role_policy" "agent_persistent_memory" {
  # memory.py — persistent memory (panasa-memory), scoped to this agent's
  # own partition key ({agent_id}#{user_id}) at the application layer, not
  # by IAM (DynamoDB's condition keys for a composite PK prefix match
  # aren't expressible here without leaf node access patterns this table
  # doesn't use).
  name = "panasa-{{ agent_id }}-persistent-memory"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"]
      Resource = "arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/{{ dynamodb_memory_table }}"
    }]
  })
}
{% endif %}

{% set tool_secrets = agent.tools | selectattr("credentials_secret_arn") | list %}
{% if tool_secrets %}
resource "aws_iam_role_policy" "agent_secrets_access" {
  name = "panasa-{{ agent_id }}-secrets-access"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = "secretsmanager:GetSecretValue"
      Resource = [
{% for tool in tool_secrets %}
        "{{ tool.credentials_secret_arn }}"{{ "," if not loop.last }}
{% endfor %}
      ]
    }]
  })
}
{% endif %}
