{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — guardrails (Bedrock Guardrails)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_bedrock_guardrail" "agent_guardrail" {
  name                      = "{{ bedrock_guardrail_name(agent_id) }}"
  blocked_input_messaging   = "This request cannot be processed."
  blocked_outputs_messaging = "This response cannot be shown."

{% if agent.guardrails.pii_detection %}
  sensitive_information_policy_config {
    pii_entities_config {
      type   = "EMAIL"
      action = "{{ "BLOCK" if agent.guardrails.pii_strip_output else "ANONYMIZE" }}"
    }
  }
{% endif %}
{% if agent.guardrails.toxicity_filter %}
  content_policy_config {
    filters_config {
      type            = "HATE"
      input_strength  = "HIGH"
      output_strength = "HIGH"
    }
  }
{% endif %}
{% if agent.guardrails.topic_filter %}
  topic_policy_config {
{% for topic in agent.guardrails.blocked_topics %}
    topics_config {
      name       = "{{ topic }}"
      type       = "DENY"
      definition = "Blocked topic: {{ topic }}"
    }
{% endfor %}
  }
{% endif %}
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_iam_role_policy" "guardrail_invoke" {
  name = "panasa-{{ agent_id }}-guardrail-invoke"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = "bedrock:ApplyGuardrail"
      # NOT aws_bedrock_guardrail.agent_guardrail.guardrail_arn above: the
      # guardrail this agent's runtime actually calls at request time is
      # whichever one its GuardrailConfig references, provisioned by the
      # Factory Runtime's own API directly against Bedrock
      # (app/modules/guardrails/provisioner.py, GuardrailPolicyRecord.
      # bedrock_guardrail_id) — a separate, already-working provisioning
      # path from this Terraform resource, which exists for the IaC
      # validation suite's structural checks but isn't what's actually
      # invoked. Scoped to any guardrail in this account/region rather
      # than the one specific (unused-at-runtime) ARN above.
      Resource = "arn:aws:bedrock:${var.aws_region}:${data.aws_caller_identity.current.account_id}:guardrail/*"
    }]
  })
}

resource "aws_iam_role_policy" "guardrail_config_read" {
  # guardrail.py resolves AgentConfiguration.guardrail_policy_id ->
  # bedrock_guardrail_id by reading its own tenant's row in the guardrail
  # policy catalog (see agent_kb_retrieve's comment above for the same
  # pattern applied to Knowledge Bases).
  name = "panasa-{{ agent_id }}-guardrail-config-read"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "dynamodb:GetItem"
      Resource = "arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/{{ dynamodb_guardrail_policies_table }}"
    }]
  })
}
