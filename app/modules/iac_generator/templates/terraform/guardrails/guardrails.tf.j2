{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — guardrails (Bedrock Guardrails)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_bedrock_guardrail" "agent_guardrail" {
  name                      = "{{ bedrock_guardrail_name(agent_id) }}"
  blocked_input_messaging   = "This request cannot be processed."
  blocked_outputs_messaging = "This response cannot be shown."

{% if agent.guardrails.pii_detection %}
  sensitive_information_policy_config {
    pii_entities_config {
      type   = "EMAIL"
      action = "{{ "BLOCK" if agent.guardrails.pii_strip_output else "ANONYMIZE" }}"
    }
  }
{% endif %}
{% if agent.guardrails.toxicity_filter %}
  content_policy_config {
    filters_config {
      type            = "HATE"
      input_strength  = "HIGH"
      output_strength = "HIGH"
    }
  }
{% endif %}
{% if agent.guardrails.topic_filter %}
  topic_policy_config {
{% for topic in agent.guardrails.blocked_topics %}
    topics_config {
      name       = "{{ topic }}"
      type       = "DENY"
      definition = "Blocked topic: {{ topic }}"
    }
{% endfor %}
  }
{% endif %}
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_iam_role_policy" "guardrail_invoke" {
  name = "panasa-{{ agent_id }}-guardrail-invoke"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "bedrock:ApplyGuardrail"
      Resource = aws_bedrock_guardrail.agent_guardrail.guardrail_arn
    }]
  })
}
