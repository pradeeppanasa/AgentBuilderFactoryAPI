{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — agent compute (ECS Fargate) + internal ALB
## Agent: {{ agent_id }}  Version: {{ version }}
## Generic Agent Runtime instruction (2026-09-03): every agent's ECS task
## runs the SAME reusable agent-runtime container image
## (services/agent-runtime/) — AGENT_ID/TENANT_ID are the only
## agent-specific inputs baked in here. The container loads everything
## else (model, prompt, KB, tools, memory, guardrails, HITL) from DynamoDB
## at startup (config_loader.py) — never bake agent config into the image
## or this task definition.
##
## API Gateway HTTP APIs can't integrate with a private ECS service
## directly; the internal ALB below is the bridge api_gateway.tf's VPC
## Link connects through (superseding an earlier draft's AWS_PROXY +
## Lambda integration, which never matched what this module actually
## creates — F0/F2).

variable "runtime_image" {
  type = string
}

variable "ecs_cluster_arn" {
  type = string
}

variable "subnet_ids" {
  type = list(string)
}

resource "aws_ecs_task_definition" "compute" {
  family                   = "panasa-{{ agent_id }}-compute"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "512"
  memory                   = "1024"
  execution_role_arn       = aws_iam_role.agent_execution_role.arn
  task_role_arn            = aws_iam_role.agent_execution_role.arn

  container_definitions = jsonencode([
    {
      name  = "agent-runtime"
      image = var.runtime_image

      portMappings = [
        { containerPort = 8080, protocol = "tcp" }
      ]

      environment = [
        { name = "AGENT_ID", value = "{{ agent_id }}" },
        { name = "TENANT_ID", value = "{{ tenant_id }}" },
        { name = "AWS_REGION", value = var.aws_region },
      ]

      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.agent_logs.name
          "awslogs-region"        = var.aws_region
          "awslogs-stream-prefix" = "runtime"
        }
      }
    }
  ])
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_lb" "agent_alb" {
  name               = "{{ alb_name(agent_id) }}"
  internal           = true
  load_balancer_type = "application"
  subnets            = var.subnet_ids
  security_groups    = [aws_security_group.agent_sg.id]
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_lb_target_group" "agent_tg" {
  name        = "{{ target_group_name(agent_id) }}"
  port        = 8080
  protocol    = "HTTP"
  vpc_id      = var.vpc_id
  target_type = "ip"

  health_check {
    path                = "/health"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 15
    timeout             = 5
  }
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_lb_listener" "agent_listener" {
  load_balancer_arn = aws_lb.agent_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.agent_tg.arn
  }
}

resource "aws_ecs_service" "compute" {
  name            = "panasa-{{ agent_id }}-compute"
  cluster         = var.ecs_cluster_arn
  task_definition = aws_ecs_task_definition.compute.arn
  desired_count   = 1
  launch_type     = "FARGATE"

  network_configuration {
    subnets         = var.subnet_ids
    security_groups = [aws_security_group.agent_sg.id]
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.agent_tg.arn
    container_name   = "agent-runtime"
    container_port   = 8080
  }

  depends_on = [aws_lb_listener.agent_listener]
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}
