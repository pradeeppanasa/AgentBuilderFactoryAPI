## Generated by Panasa Agent Builder — API Gateway front door
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_apigatewayv2_api" "agent_api" {
  name          = "panasa-agent-{{ agent_id }}"
  protocol_type = "HTTP"
}

resource "aws_apigatewayv2_stage" "agent_api_stage" {
  api_id      = aws_apigatewayv2_api.agent_api.id
  name        = "$default"
  auto_deploy = true
}

resource "aws_apigatewayv2_integration" "agent_orchestrator" {
  api_id             = aws_apigatewayv2_api.agent_api.id
  integration_type   = "AWS_PROXY"
  integration_uri    = var.orchestrator_lambda_arn
  integration_method = "POST"
}

resource "aws_apigatewayv2_route" "agent_invoke" {
  api_id    = aws_apigatewayv2_api.agent_api.id
  route_key = "POST /invoke"
  target    = "integrations/${aws_apigatewayv2_integration.agent_orchestrator.id}"
}

variable "orchestrator_lambda_arn" {
  type = string
}
