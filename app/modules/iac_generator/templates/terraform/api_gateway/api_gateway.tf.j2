{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — API Gateway front door
## Agent: {{ agent_id }}  Version: {{ version }}
## Generic Agent Runtime instruction (2026-09-03): compute.tf's ECS Fargate
## service sits behind a private, internal ALB — this HTTP API integrates
## with it through a VPC Link (HTTP_PROXY), not an AWS_PROXY/Lambda
## integration (an earlier draft's var.compute_lambda_arn never matched
## what compute.tf actually creates — F0/F2). agent_sg (base/network.tf)
## is shared across the VPC Link's ENIs, the ALB, and the ECS task itself
## — see that file's ingress rules.

resource "aws_apigatewayv2_vpc_link" "agent_vpc_link" {
  name               = "panasa-{{ agent_id }}-vpc-link"
  subnet_ids         = var.subnet_ids
  security_group_ids = [aws_security_group.agent_sg.id]
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_apigatewayv2_api" "agent_api" {
  name          = "panasa-{{ agent_id }}-api"
  protocol_type = "HTTP"
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_apigatewayv2_stage" "agent_api_stage" {
  api_id      = aws_apigatewayv2_api.agent_api.id
  name        = "$default"
  auto_deploy = true

  ## Sprint 3 Phase 9 (S-03) — a coarse, infrastructure-level DDoS/abuse
  ## backstop. Deliberately NOT derived from agent.rate_limit_rpm/rpd:
  ## those are the precise, per-agent-configurable limits enforced by the
  ## Generated Agent Runtime itself (Redis, services/agent-runtime/
  ## quota.py) with a proper 429 response body and rpm/rpd distinction.
  ## This is a fixed platform-wide ceiling underneath that, protecting the
  ## backend (VPC Link -> ALB -> ECS) from being overwhelmed regardless of
  ## what any individual agent is configured to allow.
  default_route_settings {
    throttling_rate_limit  = 100
    throttling_burst_limit = 200
  }
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

## Sprint 3 Phase 9 (S-03) — AWS-managed rule sets only (no custom rules):
## blocks common web exploits (SQLi, XSS, known bad inputs) before a
## request ever reaches the VPC Link. Always generated, unconditionally —
## this is a security baseline, not a feature toggle (Section 8's
## resolve_required_modules doesn't gate this file at all; api_gateway is
## itself always-included).
resource "aws_wafv2_web_acl" "agent_api_waf" {
  name  = "panasa-{{ agent_id }}-waf"
  scope = "REGIONAL"

  default_action {
    allow {}
  }

  rule {
    name     = "AWSManagedRulesCommonRuleSet"
    priority = 1
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesCommonRuleSet"
        vendor_name = "AWS"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "panasa-{{ agent_id }}-common-rule-set"
      sampled_requests_enabled   = true
    }
  }

  rule {
    name     = "AWSManagedRulesKnownBadInputsRuleSet"
    priority = 2
    override_action {
      none {}
    }
    statement {
      managed_rule_group_statement {
        name        = "AWSManagedRulesKnownBadInputsRuleSet"
        vendor_name = "AWS"
      }
    }
    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "panasa-{{ agent_id }}-known-bad-inputs"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "panasa-{{ agent_id }}-waf"
    sampled_requests_enabled   = true
  }
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_wafv2_web_acl_association" "agent_api_waf" {
  resource_arn = aws_apigatewayv2_stage.agent_api_stage.arn
  web_acl_arn  = aws_wafv2_web_acl.agent_api_waf.arn
}

resource "aws_apigatewayv2_integration" "agent_compute" {
  api_id             = aws_apigatewayv2_api.agent_api.id
  integration_type   = "HTTP_PROXY"
  integration_uri    = aws_lb_listener.agent_listener.arn
  integration_method = "ANY"
  connection_type    = "VPC_LINK"
  connection_id      = aws_apigatewayv2_vpc_link.agent_vpc_link.id
}

resource "aws_apigatewayv2_route" "agent_chat" {
  api_id    = aws_apigatewayv2_api.agent_api.id
  route_key = "POST /chat"
  target    = "integrations/${aws_apigatewayv2_integration.agent_compute.id}"
}

resource "aws_apigatewayv2_route" "agent_health" {
  api_id    = aws_apigatewayv2_api.agent_api.id
  route_key = "GET /health"
  target    = "integrations/${aws_apigatewayv2_integration.agent_compute.id}"
}
