{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — API Gateway front door
## Agent: {{ agent_id }}  Version: {{ version }}
## Generic Agent Runtime instruction (2026-09-03): compute.tf's ECS Fargate
## service sits behind a private, internal ALB — this HTTP API integrates
## with it through a VPC Link (HTTP_PROXY), not an AWS_PROXY/Lambda
## integration (an earlier draft's var.compute_lambda_arn never matched
## what compute.tf actually creates — F0/F2). agent_sg (base/network.tf)
## is shared across the VPC Link's ENIs, the ALB, and the ECS task itself
## — see that file's ingress rules.

resource "aws_apigatewayv2_vpc_link" "agent_vpc_link" {
  name               = "panasa-{{ agent_id }}-vpc-link"
  subnet_ids         = var.subnet_ids
  security_group_ids = [aws_security_group.agent_sg.id]
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_apigatewayv2_api" "agent_api" {
  name          = "panasa-{{ agent_id }}-api"
  protocol_type = "HTTP"
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_apigatewayv2_stage" "agent_api_stage" {
  api_id      = aws_apigatewayv2_api.agent_api.id
  name        = "$default"
  auto_deploy = true
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_apigatewayv2_integration" "agent_compute" {
  api_id             = aws_apigatewayv2_api.agent_api.id
  integration_type   = "HTTP_PROXY"
  integration_uri    = aws_lb_listener.agent_listener.arn
  integration_method = "ANY"
  connection_type    = "VPC_LINK"
  connection_id      = aws_apigatewayv2_vpc_link.agent_vpc_link.id
}

resource "aws_apigatewayv2_route" "agent_chat" {
  api_id    = aws_apigatewayv2_api.agent_api.id
  route_key = "POST /chat"
  target    = "integrations/${aws_apigatewayv2_integration.agent_compute.id}"
}

resource "aws_apigatewayv2_route" "agent_health" {
  api_id    = aws_apigatewayv2_api.agent_api.id
  route_key = "GET /health"
  target    = "integrations/${aws_apigatewayv2_integration.agent_compute.id}"
}
