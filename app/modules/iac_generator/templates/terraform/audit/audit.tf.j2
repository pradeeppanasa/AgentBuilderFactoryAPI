{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — audit trail (S3 WORM + audit Lambda)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_s3_bucket" "agent_audit" {
  bucket = "panasa-{{ agent_id }}-audit"
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_s3_bucket_public_access_block" "agent_audit" {
  bucket = aws_s3_bucket.agent_audit.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_object_lock_configuration" "agent_audit_lock" {
  bucket = aws_s3_bucket.agent_audit.id

  rule {
    default_retention {
      mode = "COMPLIANCE"
      days = 365
    }
  }
}

resource "aws_iam_role_policy" "agent_audit_write" {
  name = "panasa-{{ agent_id }}-audit-write"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "s3:PutObject"
      Resource = "${aws_s3_bucket.agent_audit.arn}/*"
    }]
  })
}
