{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — per-tool Lambda + IAM (Section 8 example)
## Agent: {{ agent_id }}  Version: {{ version }}
## Per-agent connector isolation (R21): no shared Lambdas across agents.

{% for tool in agent.tools %}
resource "aws_lambda_function" "tool_{{ tool.tool_id | replace("-", "_") }}" {
  # tool_lambda_name()/tool_role_name() (naming.py) truncate for long
  # agent_id+tool_id combinations — AWS caps Lambda function names and IAM
  # role names at 64 characters each.
  function_name = "{{ tool_lambda_name(agent_id, tool.tool_id) }}"
  role          = aws_iam_role.tool_{{ tool.tool_id | replace("-", "_") }}_role.arn
  handler       = "handler.lambda_handler"
  runtime       = "python3.12"
  filename      = "placeholder.zip" # Replaced by the customer CI/CD build step

{% if tool.credentials_secret_arn %}
  environment {
    variables = {
      # The role above only grants GetSecretValue on this one ARN (R21 /
      # Secrets rule #5) — the function fetches the value itself at
      # invocation time (Section 11's get_secret()), never at plan/apply
      # time, so the value itself never touches Terraform state.
      CREDENTIALS_SECRET_ARN = "{{ tool.credentials_secret_arn }}"
    }
  }
{% endif %}
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_iam_role" "tool_{{ tool.tool_id | replace("-", "_") }}_role" {
  name = "{{ tool_role_name(agent_id, tool.tool_id) }}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

{% if tool.credentials_secret_arn %}
resource "aws_iam_role_policy" "tool_{{ tool.tool_id | replace("-", "_") }}_secret_access" {
  name = "panasa-{{ agent_id }}-tool-{{ tool.tool_id }}-secret-access"
  role = aws_iam_role.tool_{{ tool.tool_id | replace("-", "_") }}_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "secretsmanager:GetSecretValue"
      Resource = "{{ tool.credentials_secret_arn }}"
    }]
  })
}
{% endif %}
{% endfor %}

{% if agent.tools %}
resource "aws_iam_role_policy" "agent_invoke_tools" {
  # tool_executor.py — the ECS task role (agent_execution_role,
  # authentication.tf) needs permission to invoke its own agent's tool
  # Lambdas defined above. Distinct from each tool's OWN role
  # (tool_*_role, granted only secretsmanager:GetSecretValue on its one
  # credential) — that role is who the Lambda runs as, this is who's
  # allowed to invoke it.
  name = "panasa-{{ agent_id }}-invoke-tools"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = "lambda:InvokeFunction"
      Resource = [
{% for tool in agent.tools %}
        aws_lambda_function.tool_{{ tool.tool_id | replace("-", "_") }}.arn{{ "," if not loop.last }}
{% endfor %}
      ]
    }]
  })
}
{% endif %}
