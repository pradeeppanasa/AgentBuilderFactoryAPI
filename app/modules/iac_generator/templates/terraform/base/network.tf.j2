{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — base network (CLAUDE.md F6: default-deny egress)
## Agent: {{ agent_id }}  Version: {{ version }}

variable "vpc_id" {
  type = string
}

variable "aws_region" {
  type    = string
  default = "eu-west-2"
}

variable "bedrock_endpoint_cidr" {
  type = string
}

resource "aws_security_group" "agent_sg" {
  name        = "panasa-{{ agent_id }}-sg"
  description = "Default-deny egress; every rule below is explicit (R17)"
  vpc_id      = var.vpc_id

  # Generic Agent Runtime instruction (2026-09-03): one shared security
  # group for the API Gateway VPC Link's ENIs, the internal ALB (compute.tf),
  # and the ECS task itself — self-referencing ingress covers both hops
  # (VPC Link to ALB on 80, ALB to ECS task on 8080) without needing a
  # separate security group per component. Ingress is unrelated to F6/R17's
  # default-deny EGRESS principle below. AWS's security group description
  # field rejects "->" (validated regex), hence "to" rather than an arrow.
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    self        = true
    description = "API Gateway VPC Link to internal ALB"
  }

  ingress {
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    self        = true
    description = "Internal ALB to agent-runtime container"
  }

  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.bedrock_endpoint_cidr]
    description = "Bedrock model inference"
  }

{% if agent.knowledge_base and agent.knowledge_base.enabled %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.opensearch_endpoint_cidr]
    description = "OpenSearch Knowledge Base"
  }
{% endif %}
{% for skill in agent.skills %}
{% if skill.enabled and skill.skill_id in ["web_search", "url_reader"] %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Skill '{{ skill.skill_id }}' (explicitly allowlisted, R17)"
  }
{% endif %}
{% endfor %}
{% for tool in agent.tools %}
{% if tool.endpoint %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.tool_{{ tool.tool_id | replace("-", "_") }}_cidr]
    description = "Tool: {{ tool.tool_name }}"
  }
{% endif %}
{% endfor %}
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

{% if agent.knowledge_base and agent.knowledge_base.enabled %}
variable "opensearch_endpoint_cidr" {
  type = string
}
{% endif %}
{% for tool in agent.tools %}
{% if tool.endpoint %}
variable "tool_{{ tool.tool_id | replace("-", "_") }}_cidr" {
  type = string
}
{% endif %}
{% endfor %}
