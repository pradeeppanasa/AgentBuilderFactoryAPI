## Generated by Panasa Agent Builder — base network (CLAUDE.md F6: default-deny egress)
## Agent: {{ agent_id }}  Version: {{ version }}

variable "vpc_id" {
  type = string
}

variable "aws_region" {
  type    = string
  default = "eu-west-2"
}

variable "bedrock_endpoint_cidr" {
  type = string
}

resource "aws_security_group" "agent_sg" {
  name        = "panasa-agent-{{ agent_id }}"
  description = "Default-deny egress; every rule below is explicit (R17)"
  vpc_id      = var.vpc_id

  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.bedrock_endpoint_cidr]
    description = "Bedrock model inference"
  }

{% if agent.knowledge_base and agent.knowledge_base.enabled %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.opensearch_endpoint_cidr]
    description = "OpenSearch Knowledge Base"
  }
{% endif %}
{% for skill in agent.skills %}
{% if skill.enabled and skill.skill_id in ["web_search", "url_reader"] %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Skill '{{ skill.skill_id }}' (explicitly allowlisted, R17)"
  }
{% endif %}
{% endfor %}
{% for tool in agent.tools %}
{% if tool.endpoint %}
  egress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.tool_{{ tool.tool_id | replace("-", "_") }}_cidr]
    description = "Tool: {{ tool.tool_name }}"
  }
{% endif %}
{% endfor %}
}

{% if agent.knowledge_base and agent.knowledge_base.enabled %}
variable "opensearch_endpoint_cidr" {
  type = string
}
{% endif %}
{% for tool in agent.tools %}
{% if tool.endpoint %}
variable "tool_{{ tool.tool_id | replace("-", "_") }}_cidr" {
  type = string
}
{% endif %}
{% endfor %}
