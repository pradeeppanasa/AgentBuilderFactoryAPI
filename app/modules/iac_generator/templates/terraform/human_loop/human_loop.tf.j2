{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — human-in-the-loop (Step Functions + SNS + SQS)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_sns_topic" "human_review_notifications" {
  name = "panasa-{{ agent_id }}-human-review"
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_sqs_queue" "human_review_queue" {
  name = "panasa-{{ agent_id }}-human-review"
  # AWS caps SQS visibility_timeout_seconds at 43200 (12h) — approval_timeout_hours
  # can be configured well beyond that (HumanReviewConfig's own default,
  # 24h, already exceeds it), so this clamps rather than passing the raw
  # value straight through and failing terraform_validate/apply.
  visibility_timeout_seconds = {{ [agent.human_review.approval_timeout_hours * 3600, 43200] | min }}
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

resource "aws_sfn_state_machine" "human_review_workflow" {
  name     = "panasa-{{ agent_id }}-human-review"
  role_arn = aws_iam_role.agent_execution_role.arn

  definition = jsonencode({
    StartAt = "AwaitApproval"
    States = {
      AwaitApproval = {
        Type     = "Task"
        Resource = "arn:aws:states:::sqs:sendMessage.waitForTaskToken"
        Parameters = {
          QueueUrl    = aws_sqs_queue.human_review_queue.id
          MessageBody = "$.reviewRequest"
        }
        TimeoutSeconds = {{ agent.human_review.approval_timeout_hours * 3600 }}
        End            = true
      }
    }
  })
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}
