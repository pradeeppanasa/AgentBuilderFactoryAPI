{% import "_macros.tf.j2" as macros %}
## Generated by Panasa Agent Builder — observability (CloudWatch + X-Ray)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_cloudwatch_log_group" "agent_logs" {
  name              = "panasa-{{ agent_id }}-logs"
  retention_in_days = 30
{{ macros.panasa_tags(agent_id, tenant_id, version) }}
}

{% if agent.observability_enabled %}
resource "aws_iam_role_policy" "agent_xray_access" {
  name = "panasa-{{ agent_id }}-xray"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      # X-Ray's PutTraceSegments/PutTelemetryRecords have no resource-level
      # permissions in AWS's IAM action reference — Resource = "*" here is
      # the AWS API's own constraint, not a least-privilege violation (same
      # documented exception pattern as bootstrap/stage0/iam.tf's
      # ecs:RegisterTaskDefinition statement).
      Action   = ["xray:PutTraceSegments", "xray:PutTelemetryRecords"]
      Resource = "*"
    }]
  })
}
{% endif %}
