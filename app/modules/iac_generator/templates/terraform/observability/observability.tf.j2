## Generated by Panasa Agent Builder — observability (CloudWatch + X-Ray)
## Agent: {{ agent_id }}  Version: {{ version }}

resource "aws_cloudwatch_log_group" "agent_logs" {
  name              = "/panasa/agents/{{ agent_id }}"
  retention_in_days = 30
}

{% if agent.observability_enabled %}
resource "aws_iam_role_policy" "agent_xray_access" {
  name = "panasa-agent-{{ agent_id }}-xray"
  role = aws_iam_role.agent_execution_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["xray:PutTraceSegments", "xray:PutTelemetryRecords"]
      Resource = "*"
    }]
  })
}
{% endif %}
