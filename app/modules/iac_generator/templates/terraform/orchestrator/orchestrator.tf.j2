## Generated by Panasa Agent Builder — orchestrator compute (ECS Fargate)
## Agent: {{ agent_id }}  Version: {{ version }}

variable "runtime_image" {
  type = string
}

variable "ecs_cluster_arn" {
  type = string
}

variable "subnet_ids" {
  type = list(string)
}

resource "aws_ecs_task_definition" "orchestrator" {
  family                   = "panasa-agent-{{ agent_id }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "512"
  memory                   = "1024"
  execution_role_arn       = aws_iam_role.agent_execution_role.arn
  task_role_arn            = aws_iam_role.agent_execution_role.arn

  container_definitions = jsonencode([
    {
      name  = "agent"
      image = var.runtime_image
      environment = [
        { name = "AGENT_ID", value = "{{ agent_id }}" },
        { name = "AGENT_VERSION", value = "{{ version }}" },
        { name = "MODEL_ID", value = "{{ agent.model_id }}" },
        { name = "MODEL_PROVIDER", value = "{{ agent.model_provider }}" },
      ]
    }
  ])
}

resource "aws_ecs_service" "orchestrator" {
  name            = "panasa-agent-{{ agent_id }}"
  cluster         = var.ecs_cluster_arn
  task_definition = aws_ecs_task_definition.orchestrator.arn
  desired_count   = 1
  launch_type     = "FARGATE"

  network_configuration {
    subnets         = var.subnet_ids
    security_groups = [aws_security_group.agent_sg.id]
  }
}
