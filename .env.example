# ── Deployment mode ──────────────────────────────────────────
DEPLOYMENT_MODE=prototype              # prototype | enterprise

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=123456789012

# ── Agent Registry (DynamoDB) ──────────────────────────────────
DYNAMODB_AGENTS_TABLE=panasa-agents
DYNAMODB_VERSIONS_TABLE=panasa-agent-versions
DYNAMODB_DEPLOYMENTS_TABLE=panasa-deployments
DYNAMODB_CONNECTORS_TABLE=panasa-connectors
DYNAMODB_SCHEDULES_TABLE=panasa-schedules
DYNAMODB_CONNECTIONS_TABLE=panasa-connections
DYNAMODB_MEMORY_TABLE=panasa-memory
DYNAMODB_MCP_SERVERS_TABLE=panasa-mcp-servers
DYNAMODB_SKILLS_TABLE=panasa-skills
DYNAMODB_TRANSCRIPTS_TABLE=panasa-transcripts
DYNAMODB_REPORTS_TABLE=panasa-reports

# ── Advanced Config: KB / Guardrail Policy / Playground (Section 37.12) ──
DYNAMODB_KNOWLEDGE_BASES_TABLE=panasa-knowledge-bases
DYNAMODB_GUARDRAIL_POLICIES_TABLE=panasa-guardrail-policies
DYNAMODB_PLAYGROUND_SESSIONS_TABLE=panasa-playground-sessions
DYNAMODB_BEDROCK_CREDENTIALS_TABLE=panasa-bedrock-credentials

# ── Projects / Skills / HITL (Section 38) ─────────────────────────────────
DYNAMODB_PROJECTS_TABLE=panasa-projects
DYNAMODB_HITL_REVIEWS_TABLE=panasa-hitl-reviews

# ── Skills ───────────────────────────────────────────────────────
TAVILY_API_KEY_SECRET_ARN=arn:aws:secretsmanager:...:secret:tavily-api-key
CODE_SANDBOX_LAMBDA_ARN=arn:aws:lambda:eu-west-2:...:function:panasa-code-sandbox
TRANSCRIPT_S3_BUCKET=panasa-transcripts-<account>
REPORTS_S3_BUCKET=panasa-reports-<account>
TRANSCRIPT_RETENTION_DAYS=90

# ── Deployment pipeline ───────────────────────────────────────
EVENTBRIDGE_BUS_NAME=panasa-agent-builder
STEP_FUNCTIONS_ARN=arn:aws:states:eu-west-2:123456789012:stateMachine:panasa-deployment

# ── IaC & Git ───────────────────────────────────────────────────
IAC_OUTPUT_BUCKET=panasa-iac-artifacts-<account>
IAC_TOOL=terraform                     # terraform | cdk
GIT_PROVIDER=github                    # github | gitlab | bitbucket | codecommit
GIT_REPO_URL=https://github.com/org/panasa-agent-iac
GIT_CREDENTIALS_SECRET=arn:aws:secretsmanager:eu-west-2:...:secret:git-token
# Section 45.2 — one private repo per agent, named panasa-iac-{agent_id},
# created under this org/namespace (ignored for GIT_PROVIDER=codecommit).
GIT_ORG=your-github-org-or-username
GIT_DEFAULT_BRANCH=main

# ── Terraform backend (enterprise only) ────────────────────────
TF_STATE_BUCKET=customer-tf-state-<account>
TF_STATE_LOCK_TABLE=customer-tf-lock

# ── Development Terraform Validation Modes ─────────────────────────────
# "local" (default, always available) never requires AWS credentials.
# Leave the flag below false in production — it only unhides the
# admin/developer-only "panasa_vpc"/"customer_vpc" placeholder modes on
# POST /agents/{id}/generate-iac, which still never perform a real
# deployment in this stage.
DEV_VALIDATION_EXTENDED_MODES_ENABLED=false

# ── Platform ──────────────────────────────────────────────────────
PLATFORM_VERSION=1.0.0
RUNTIME_IMAGE=123456789012.dkr.ecr.eu-west-2.amazonaws.com/agent-builder-runtime:1.0.0

# ── Platform upgrade (Phase 15) ─────────────────────────────────────
DYNAMODB_PLATFORM_UPGRADES_TABLE=panasa-platform-upgrades
PLATFORM_UPGRADE_STATE_MACHINE_ARN=arn:aws:states:eu-west-2:123456789012:stateMachine:panasa-platform-upgrade
ECS_CLUSTER_NAME=panasa-prototype-cluster
ECS_RUNTIME_SERVICE_NAME=agent-builder-runtime
ECS_TASK_DEFINITION_FAMILY=panasa-prototype-agent-builder-runtime
PLATFORM_HEALTH_CHECK_URL=http://localhost:8000/api/v1/platform/health

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:...:secret:jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (Phase 3 — user accounts) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://panasa:panasa@localhost:5432/panasa_agent_builder

# ── Secrets Manager ───────────────────────────────────────────────
SECRETS_MANAGER_PREFIX=panasa/agents

# ── Telemetry (opt-in, default OFF) ───────────────────────────────
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=https://telemetry.panasa.io/v1/ingest

# ── Observability ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# R45: Langfuse is optional and customer-routed — never a required runtime
# dependency. Default OFF; the admin observability settings page can also
# toggle this per tenant at runtime via PATCH /admin/settings/integrations/langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
CLOUDWATCH_METRICS_NAMESPACE=Panasa/AgentBuilder

# ── Audit (Phase 14 — S3 WORM) ─────────────────────────────────────
AUDIT_S3_BUCKET=panasa-audit-<account>

# ── OAuth Connections ───────────────────────────────────────────────
OAUTH_CALLBACK_BASE_URL=https://factory.panasa.io   # or https://factory.customer.com in enterprise
JIRA_OAUTH_CLIENT_ID=...
JIRA_OAUTH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:...:secret:jira-oauth-secret
GITHUB_OAUTH_CLIENT_ID=...
GITHUB_OAUTH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:...:secret:github-oauth-secret
SLACK_OAUTH_CLIENT_ID=...
SLACK_OAUTH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:...:secret:slack-oauth-secret
# Add remaining providers following same pattern

# ── AI Prompt Generation ─────────────────────────────────────────────
PROMPT_GEN_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0   # Fast + cheap for generation
PROMPT_GEN_MAX_TOKENS=2048

# ── License (F11 — enterprise mode only) ─────────────────────────────
LICENSE_TOKEN_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:ACCOUNT:secret:panasa/license-token

# ── Playground mock mode (dev/test only) ──────────────────────────────
# Skips the real LLM/guardrail Bedrock calls in POST /agents/{id}/playground
# and returns a canned response instead — useful in local dev where
# AWS_ACCESS_KEY_ID=local can't authenticate to real Bedrock. Individual
# requests can also opt in with ?mock=true regardless of this flag. Never
# set true in prototype/enterprise deployments.
MOCK_LLM=false

# QA A-05 — skips the real Bedrock CreateGuardrail/UpdateGuardrail/
# DeleteGuardrail calls in POST/PUT/DELETE /platform/guardrail-policies and
# returns a fake guardrail_id instead — same rationale as MOCK_LLM above.
# Never set true in prototype/enterprise deployments.
MOCK_BEDROCK_GUARDRAILS=false

# instructions_kb_api.md / CLAUDE.md Section 43 — skips the real Bedrock
# CreateKnowledgeBase/CreateDataSource/StartIngestionJob calls in
# POST /platform/knowledge-bases and returns fake ids instead — same
# rationale as MOCK_BEDROCK_GUARDRAILS above. Never set true in
# prototype/enterprise deployments.
MOCK_BEDROCK_KB=false

# TS02-A-03 — skips the real GitHub/GitLab/Bitbucket API calls in
# POST /agents/{id}/deploy and POST /agents/{id}/rollback, returning fake
# branch/commit/PR ids instead — same rationale as MOCK_BEDROCK_GUARDRAILS
# above (local dev's GIT_REPO_URL/GIT_CREDENTIALS_SECRET point at a
# placeholder, not a real repo). Never set true in prototype/enterprise
# deployments.
MOCK_GIT_PROVIDER=false

# ── Knowledge Base — S3 + Bedrock provisioning ────────────────────────
# Unset (default) disables real S3/Bedrock provisioning for new knowledge
# bases — POST /platform/knowledge-bases falls back to DynamoDB-only
# behaviour, same as before this existed.
KB_DOCUMENTS_BUCKET=panasa-kb-documents-<account_id>
BEDROCK_KB_ROLE_ARN=arn:aws:iam::<account_id>:role/panasa-bedrock-kb-role
OPENSEARCH_COLLECTION_ARN=arn:aws:aoss:eu-west-2:<account_id>:collection/<collection_id>

# Observability — Runs Feature, Phase 1. No real Generated Agent Runtime is
# ever deployed in this Stage 1 environment (R46), so there is no real run
# telemetry to show. Gates POST /agents/{id}/runs/seed-demo, which inserts
# four synthetic runs (success/failed/running/scheduler) so the Runs list/
# detail/filters can be exercised end to end. Never set true in prototype/
# enterprise deployments serving real traffic.
SEED_RUNS_ENABLED=false

# ── LiteLLM Model Router (Section 32.1) ───────────────────────────────
LITELLM_LOG=WARNING                    # DEBUG | INFO | WARNING
LITELLM_TELEMETRY=false                # R28 — always disabled
# Bedrock uses AWS_REGION above. Azure OpenAI / self-hosted are optional —
# only needed if an agent's model_provider selects them.
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01
OPENAI_API_BASE=http://localhost:11434/v1   # e.g. Ollama
OPENAI_API_KEY=ollama                        # placeholder

# ── Redis cache layer (Section 32.2) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=1.0

# ── Guardrail Layer 1 — local ONNX BERT classifier ────────────────────
# Base directory holding one pre-exported ONNX model per bert_model name,
# e.g. ${GUARDRAILS_BERT_MODEL_DIR}/unitary/toxic-bert/{model.onnx,
# tokenizer.json, config.json}. Never fetched at runtime — populate this
# during image build (enterprise) or point at a customer-supplied artifact
# location. Leave unset to run with Guardrail Layer 1 disabled/unavailable.
GUARDRAILS_BERT_MODEL_DIR=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Never "*" — see app/config.py's comment
# for why that pairs badly with allow_credentials=True (TS02-A-02).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Local dev overrides ───────────────────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8001        # DynamoDB Local
SECRETS_MANAGER_ENDPOINT=http://localhost:4566 # LocalStack — see scripts/seed_localstack.py
S3_ENDPOINT=http://localhost:4566              # LocalStack

# ── Local dev bootstrap (scripts/create_admin.py only — never read at
# runtime by the app itself) ───────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@panasa.dev
DEFAULT_ADMIN_PASSWORD=ChangeMe123!            # local dev only — change immediately for anything else
DEFAULT_ADMIN_TENANT_ID=default
